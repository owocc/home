---
import siteConfig from '../data/site';
import ArrowUp from '@lucide/astro/icons/arrow-up';
---

<footer class="site-footer">
	<div class="site-footer__inner shell">
		<div>
			<p class="display site-footer__headline">KEEP MAKING<br />GOOD THINGS.</p>
			<p class="script site-footer__scribble">see you around!</p>
		</div>
		<div class="site-footer__meta">
			<p>© {new Date().getFullYear()} {siteConfig.identity.name}</p>
			<p>用 Astro、纸张质感与一点好奇心制作。</p>
			<a href="#main-content">回到页首 <ArrowUp class="icon" size={16} stroke-width={2.5} /></a>
		</div>
	</div>
</footer>
