---
import siteConfig from '../data/site';
import Sparkles from '@lucide/astro/icons/sparkles';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => {
	if (href === '/') return currentPath === '/';
	if (href.includes('#')) return false;
	return currentPath.startsWith(href);
};
---

<header class="site-header">
	<div class="site-header__inner shell">
		<a class="site-brand" href="/" aria-label={`${siteConfig.identity.name}，返回首页`}>
			<span class="site-brand__mark" aria-hidden="true"><Sparkles class="icon" size={22} stroke-width={2.4} /></span>
			<span>
				<strong>{siteConfig.identity.name}</strong>
				<small>{siteConfig.identity.role}</small>
			</span>
		</a>
		<nav class="site-nav" aria-label="主导航">
			<ul>
				{siteConfig.navigation.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
