---
import siteConfig, { type NavigationItem } from "../data/site";
import Sun from "@lucide/astro/icons/sun";
import Moon from "@lucide/astro/icons/moon";
import Monitor from "@lucide/astro/icons/monitor";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Globe from "@lucide/astro/icons/globe";

interface Props {
    currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => {
    if (href === "/") return currentPath === "/";
    if (href.includes("#")) return false;
    return currentPath.startsWith(href);
};
const navItems = siteConfig.navigation as readonly NavigationItem[];
---

<header class="site-header" id="site-header">
    <div class="site-header__inner shell">
        <a class="site-brand" href="/" aria-label={`${siteConfig.identity.name}，返回首页`}>
            <span class="site-brand__name">{siteConfig.username}</span>
        </a>

        <div class="site-header__right">
            <nav class="site-nav" id="site-nav" aria-label="主导航">
                <ul>
                    {
                        navItems.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    target={item.external ? "_blank" : undefined}
                                    rel={item.external ? "noopener noreferrer" : undefined}
                                    aria-current={
                                        isCurrent(item.href) ? "page" : undefined
                                    }
                                    data-nav-href={item.href}
                                >
                                    <span data-i18n-key={`nav.${item.href === '/' ? 'home' : item.href.replace(/[/_#]/g, '')}`}>{item.label}</span>
                                    {item.external && (
                                        <ArrowUpRight class="icon" size={14} stroke-width={2.4} />
                                    )}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div class="site-header__controls">
                <!-- Language Switcher Button -->
                <button
                    type="button"
                    class="lang-toggle-btn"
                    id="lang-toggle"
                    aria-label="切换语言 / Switch Language"
                    title="切换语言 / Switch Language"
                >
                    <Globe class="icon" size={16} stroke-width={2.3} />
                    <span id="current-lang-text">CN</span>
                </button>
                <!-- Theme Toggle Button: light -> dark -> system (cycle) -->
                <button
                    type="button"
                    class="theme-toggle"
                    id="theme-toggle"
                    aria-label="切换主题"
                    title="切换主题"
                >
                    <Sun class="icon-sun" size={20} stroke-width={2.2} aria-hidden="true" />
                    <Moon class="icon-moon" size={20} stroke-width={2.2} aria-hidden="true" />
                    <Monitor class="icon-monitor" size={20} stroke-width={2.2} aria-hidden="true" />
                </button>

                <!-- Mobile Menu Button -->
                <button
                    type="button"
                    class="mobile-menu-btn"
                    id="mobile-menu-toggle"
                    aria-expanded="false"
                    aria-controls="site-nav"
                    aria-label="打开导航菜单"
                >
                    <Menu class="icon-menu" size={22} stroke-width={2.4} />
                    <X class="icon-close" size={22} stroke-width={2.4} style="display: none;" />
                </button>
            </div>
        </div>
    </div>
</header>
<script>
    import { ui, type Language } from '../data/i18n';

    type Theme = 'light' | 'dark' | 'system';
    const THEME_ORDER: readonly Theme[] = ['light', 'dark', 'system'];
    const isTheme = (v: unknown): v is Theme => v === 'light' || v === 'dark' || v === 'system';

    let currentLang: Language = 'cn';
    let mobileNavWindowListenersBound = false;

    function getStoredTheme(): Theme {
        try {
            const t = localStorage.getItem('theme');
            if (isTheme(t)) return t;
        } catch (e) {}
        return 'system';
    }
    function nextTheme(t: Theme): Theme {
        const i = THEME_ORDER.indexOf(t);
        return THEME_ORDER[(i + 1) % THEME_ORDER.length];
    }
    const THEME_LABEL: Record<Theme, string> = {
        light: '浅色模式',
        dark: '深色模式',
        system: '跟随系统',
    };
    function themeA11y(theme: Theme): string {
        return `${THEME_LABEL[theme]} — 点击切换`;
    }
    function syncThemeButton() {
        const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
        if (!btn) return;
        const t = getStoredTheme();
        // Also fall back to DOM if localStorage not yet written (first visit).
        const dom = document.documentElement.getAttribute('data-theme');
        const theme: Theme = isTheme(t) ? t : isTheme(dom) ? (dom as Theme) : 'system';
        btn.setAttribute('aria-label', themeA11y(theme));
        // Tooltip shows current state + hint; accessible name is the aria-label.
        const hint = `当前：${THEME_LABEL[theme]}（${THEME_LABEL[nextTheme(theme)]}）`;
        btn.setAttribute('title', hint);
        btn.setAttribute('data-theme-state', theme);
    }

    // Theme toggle — per-element guard; new header after swap gets a fresh button.
    const initThemeToggle = () => {
        syncThemeButton();
        const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
        if (!themeBtn) return;
        if (themeBtn.dataset.bound === '1') return;
        themeBtn.dataset.bound = '1';

        themeBtn.addEventListener('click', () => {
            const cur = getStoredTheme();
            const nxt = nextTheme(cur);
            document.documentElement.setAttribute('data-theme', nxt);
            try {
                localStorage.setItem('theme', nxt);
            } catch (e) {}
            syncThemeButton();
        });
    };

    const syncLanguage = () => {
        const langText = document.getElementById('current-lang-text');
        try {
            const stored = localStorage.getItem('site_lang');
            currentLang = stored === 'en' || stored === 'cn' ? stored : 'cn';
        } catch (e) {
            currentLang = 'cn';
        }
        document.documentElement.setAttribute('lang', currentLang === 'en' ? 'en-US' : 'zh-CN');
        document.documentElement.setAttribute('data-lang', currentLang);
        if (langText) langText.textContent = currentLang === 'en' ? 'EN' : 'CN';
        document.querySelectorAll<HTMLElement>('[data-i18n-key]').forEach((el) => {
            const key = el.getAttribute('data-i18n-key') as keyof typeof ui['cn'];
            if (key && ui[currentLang] && ui[currentLang][key]) el.textContent = ui[currentLang][key];
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-trans-badge]').forEach((el) => {
            const type = el.getAttribute('data-i18n-trans-badge');
            if (type === 'has-en') el.textContent = currentLang === 'en' ? 'EN Available' : '有 EN 译文';
            else if (type === 'has-cn') el.textContent = currentLang === 'en' ? 'CN Available' : '有 CN 中文版';
        });
        window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang: currentLang } }));
    };

    const initLangToggle = () => {
        syncLanguage();
        const langBtn = document.getElementById('lang-toggle') as HTMLButtonElement | null;
        if (!langBtn || langBtn.dataset.bound === '1') return;
        langBtn.dataset.bound = '1';
        langBtn.addEventListener('click', () => {
            const nextLang: Language = currentLang === 'cn' ? 'en' : 'cn';
            currentLang = nextLang;
            try {
                localStorage.setItem('site_lang', nextLang);
            } catch (e) {}
            syncLanguage();
        });
    };

    const initMobileNav = () => {
        const header = document.getElementById('site-header');
        const menuBtn = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
        const nav = document.getElementById('site-nav');
        if (!header || !menuBtn || !nav) return;

        const alreadyBound = menuBtn.dataset.bound === '1';
        if (!alreadyBound) {
            menuBtn.dataset.bound = '1';
            const iconMenu = menuBtn.querySelector('.icon-menu') as HTMLElement | null;
            const iconClose = menuBtn.querySelector('.icon-close') as HTMLElement | null;
            const toggleMenu = (open?: boolean) => {
                const willOpen = typeof open === 'boolean' ? open : !header.classList.contains('nav-open');
                if (willOpen) {
                    header.classList.add('nav-open');
                    menuBtn.setAttribute('aria-expanded', 'true');
                    menuBtn.setAttribute('aria-label', '关闭导航菜单');
                    if (iconMenu && iconClose) {
                        iconMenu.style.display = 'none';
                        iconClose.style.display = 'block';
                    }
                    document.body.style.overflow = 'hidden';
                } else {
                    header.classList.remove('nav-open');
                    menuBtn.setAttribute('aria-expanded', 'false');
                    menuBtn.setAttribute('aria-label', '打开导航菜单');
                    if (iconMenu && iconClose) {
                        iconMenu.style.display = 'block';
                        iconClose.style.display = 'none';
                    }
                    document.body.style.overflow = '';
                }
            };
            menuBtn.addEventListener('click', () => toggleMenu());
            nav.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => toggleMenu(false));
            });
        }

        if (!mobileNavWindowListenersBound) {
            mobileNavWindowListenersBound = true;
            window.addEventListener('keydown', (e) => {
                const h = document.getElementById('site-header');
                if (e.key === 'Escape' && h?.classList.contains('nav-open')) {
                    h.classList.remove('nav-open');
                    document.body.style.overflow = '';
                    const btn = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
                    btn?.setAttribute('aria-expanded', 'false');
                    btn?.setAttribute('aria-label', '打开导航菜单');
                    const im = btn?.querySelector('.icon-menu') as HTMLElement | null;
                    const ic = btn?.querySelector('.icon-close') as HTMLElement | null;
                    if (im && ic) { im.style.display = 'block'; ic.style.display = 'none'; }
                }
            });
            window.addEventListener('resize', () => {
                const h = document.getElementById('site-header');
                if (window.innerWidth > 900 && h?.classList.contains('nav-open')) {
                    h.classList.remove('nav-open');
                    document.body.style.overflow = '';
                    const btn = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
                    btn?.setAttribute('aria-expanded', 'false');
                    btn?.setAttribute('aria-label', '打开导航菜单');
                    const im = btn?.querySelector('.icon-menu') as HTMLElement | null;
                    const ic = btn?.querySelector('.icon-close') as HTMLElement | null;
                    if (im && ic) { im.style.display = 'block'; ic.style.display = 'none'; }
                }
            }, { passive: true });
        }
    };

    const initHeader = () => {
        initThemeToggle();
        initLangToggle();
        initMobileNav();
    };

    initHeader();
    document.addEventListener('astro:page-load', initHeader);
</script>
