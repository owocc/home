---
import type { CollectionEntry } from 'astro:content';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Languages from '@lucide/astro/icons/languages';

interface Props {
	post: CollectionEntry<'blog'>;
	index: number;
}

const { post, index } = Astro.props;
const isEn = post.data.lang === 'en';
const date = new Intl.DateTimeFormat(isEn ? 'en-US' : 'zh-CN', {
	year: 'numeric',
	month: isEn ? 'short' : '2-digit',
	day: '2-digit',
}).format(post.data.publishedAt);
---

<article class="blog-card" data-reveal>
	<a href={`/blog/${post.id}/`}>
		<div class="blog-card__index display" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
		<div class="blog-card__content">
			<div class="blog-card__meta">
				<time datetime={post.data.publishedAt.toISOString()}>{date}</time>
				<span>·</span>
				<span>{post.data.tags[0]}</span>
				<div class="blog-card__badges">
					<span class:list={['lang-pill', isEn ? 'lang-pill--en' : 'lang-pill--cn']} data-i18n-lang-badge={post.data.lang}>
						{isEn ? 'EN' : 'CN'}
					</span>
					{post.data.hasTranslation && (
						<span class="translation-pill" title={isEn ? 'Translations available' : '提供多语言翻译版本'}>
							<Languages class="icon" size={13} stroke-width={2.2} />
							<span class="translation-pill__text" data-i18n-trans-badge={isEn ? 'has-cn' : 'has-en'}>
								{isEn ? 'CN Available' : '有 EN 译文'}
							</span>
						</span>
					)}
				</div>
			</div>
			<h3>{post.data.title}</h3>
			<p>{post.data.description}</p>
		</div>
		<span class="blog-card__arrow" aria-hidden="true"><ArrowUpRight class="icon" size={42} stroke-width={2.2} /></span>
	</a>
</article>
