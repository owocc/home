---
import { getCollection } from 'astro:content';
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CodeXml from '@lucide/astro/icons/code-xml';
import Pencil from '@lucide/astro/icons/pencil';
import Sparkles from '@lucide/astro/icons/sparkles';
import MessageCircle from '@lucide/astro/icons/message-circle';
import BlogCard from '../components/BlogCard.astro';
import HeroCharacter from '../components/HeroCharacter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import siteConfig from '../data/site';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.filter(({ data }) => data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3);
---

<Layout title={siteConfig.title}>
	<section class="home-hero" aria-labelledby="hero-title">
		<div class="home-hero__canvas shell">
			<!-- Rotating Speech Bubble (changes message every 5s) -->
			<div class="home-hero__welcome eyebrow" id="hero-speech-bubble" data-reveal>
				<div class="home-hero__bubble-inner" id="hero-bubble-text">
					<MessageCircle class="icon" size={15} stroke-width={2.4} />
					<span id="hero-bubble-content">{siteConfig.heroQuotes.cn[0]}</span>
				</div>
			</div>

			<div class="home-hero__scene">
				<div class="home-hero__stage">
					<div class="home-hero__wall" aria-hidden="true">
						<span class="home-hero__wall-label display">IDEAS</span>
						<span class="hero-sticker hero-sticker--code" data-parallax="1.1"><CodeXml class="icon" size={30} stroke-width={2.4} /></span>
						<span class="hero-sticker hero-sticker--spark" data-parallax="1.6"><Sparkles class="icon" size={34} stroke-width={2.3} /></span>
						<span class="hero-sticker hero-sticker--note script" data-parallax="0.7">make it real!</span>
					</div>
				</div>
				<HeroCharacter />
			</div>

			<div class="home-hero__title-wrap" data-reveal>
				<span class="home-hero__script script" aria-hidden="true">personal</span>
				<h1 id="hero-title" class="display" aria-label={`${siteConfig.identity.name}的个人作品集`}>
					<span>PORT</span><span class="poster-label">FOLIO.</span>
				</h1>
			</div>

			<div class="home-hero__bottom" data-reveal>
				<p class="home-hero__role">
					<span class="eyebrow" data-i18n-key="hero.currently">CURRENTLY</span>
					<strong data-i18n-key="hero.role">{siteConfig.identity.role}</strong>
				</p>
				<p class="home-hero__intro" data-i18n-key="hero.intro">{siteConfig.identity.intro}</p>
				<a class="button" href="#projects"><span data-i18n-key="hero.scrollDown">向下看看</span> <ArrowDown class="icon" size={16} stroke-width={2.5} /></a>
			</div>
		</div>
	</section>

	<section class="section home-about" id="about" aria-labelledby="about-title">
		<div class="shell">
			<SectionHeading id="about-title" eyebrow="ABOUT / 关于我" title="灵感落地的地方" number="01" />
			<div class="home-about__grid">
				<div class="home-about__statement" data-reveal>
					<p class="display">GOOD<br /><span>IDEAS</span><br />NEED<br />A SHAPE.</p>
					<span class="home-about__doodle script" aria-hidden="true">that feels right <ArrowRight class="icon" size={25} stroke-width={2.2} /></span>
				</div>
				<div class="home-about__copy paper-panel" data-reveal>
					<p class="eyebrow"><span data-i18n-key="about.introHeading">你好，我是 owocc</span></p>
					<p data-i18n-key="about.bio1">{siteConfig.identity.bio[0]}</p>
					<p data-i18n-key="about.bio2">{siteConfig.identity.bio[1]}</p>
					<dl class="home-about__facts">
						<div>
							<dt data-i18n-key="common.location">所在地</dt>
							<dd data-i18n-key="about.locationVal">{siteConfig.identity.location}</dd>
						</div>
						<div>
							<dt data-i18n-key="common.status">当前状态</dt>
							<dd data-i18n-key="about.statusVal">{siteConfig.identity.availability}</dd>
						</div>
					</dl>
					{siteConfig.identity.isPlaceholder && (
						<p class="placeholder-note"><Pencil class="icon" size={15} stroke-width={2.5} /> 这是可替换的示例资料，内容集中在 site.ts 中。</p>
					)}
				</div>
			</div>
		</div>
	</section>

	<section class="section home-projects" id="projects" aria-labelledby="projects-title">
		<div class="shell">
			<SectionHeading id="projects-title" eyebrow="SELECTED WORK / 精选项目" title="做过的一些东西" number="02" />
			<div class="project-grid">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
			<div class="home-section-link" data-reveal>
				<a class="button button--ink" href="/projects/"><span data-i18n-key="projects.viewAll">查看全部项目</span> <ArrowUpRight class="icon" size={16} stroke-width={2.5} /></a>
			</div>
		</div>
	</section>

	<section class="section home-resume" aria-labelledby="resume-title">
		<div class="shell">
			<SectionHeading id="resume-title" eyebrow="EXPERIENCE / 经历" title="一份很短的简历" number="03" />
			<div class="home-resume__grid">
				<div class="home-resume__timeline">
					{siteConfig.experience.map((item, index) => (
						<article class="resume-row" data-reveal>
							<span class="resume-row__number display" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<p class="eyebrow">{item.period}</p>
								<h3>{item.role}</h3>
								<p class="resume-row__org">{item.organization}</p>
								<p>{item.summary}</p>
							</div>
						</article>
					))}
				</div>
				<aside class="home-resume__skills" data-reveal aria-label="技能摘要">
					<p class="script">tools in my bag</p>
					{siteConfig.skills.map((group) => (
						<div class="skill-group">
							<h3 class="eyebrow">{group.label}</h3>
							<ul class="tag-list">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))}
					<a class="button" href="/resume/"><span data-i18n-key="experience.openFull">打开完整简历</span> <ArrowRight class="icon" size={16} stroke-width={2.5} /></a>
				</aside>
			</div>
		</div>
	</section>

	<section class="section home-blog" aria-labelledby="blog-title">
		<div class="shell">
			<SectionHeading id="blog-title" eyebrow="FIELD NOTES / 创作笔记" title="最近写下的东西" number="04" />
			<div class="blog-list">
				{posts.map((post, index) => <BlogCard post={post} index={index} />)}
			</div>
			<div class="home-section-link" data-reveal>
				<a class="button" href="/blog/"><span data-i18n-key="blog.viewAll">翻阅全部文章</span> <ArrowUpRight class="icon" size={16} stroke-width={2.5} /></a>
			</div>
		</div>
	</section>

	<section class="home-contact" id="contact" aria-labelledby="contact-title">
		<div class="home-contact__inner shell">
			<div data-reveal>
				<p class="eyebrow" data-i18n-key="contact.kicker">CONTACT / 找我聊聊</p>
				<h2 id="contact-title" class="display">LET'S MAKE<br /><span>SOMETHING</span><br />GOOD.</h2>
			</div>
			<div class="home-contact__card" data-reveal>
				<p class="script">say hello!</p>
				<h3 data-i18n-key="contact.heading">{siteConfig.contact.heading}</h3>
				<p data-i18n-key="contact.message">{siteConfig.contact.message}</p>
				<a class="home-contact__email" href={`mailto:${siteConfig.contact.email}`}>
					{siteConfig.contact.email} <ArrowUpRight class="icon" size={18} stroke-width={2.4} />
				</a>
				<ul class="home-contact__socials" aria-label="社交链接">
					{siteConfig.contact.socials.map((social) => (
						<li><a href={social.href} rel="me">{social.label}</a></li>
					))}
				</ul>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	(function() {
		const cnQuotes = [
			'HELLO, I MAKE THINGS WITH IDEAS & CODE ✨',
			'欢迎来到 owocc 的手作数字小站 🎨',
			'让设计与代码自然发生，充满生命力 🚀',
			'这里记录实验、草图与好奇心 💡',
			'保持好奇，持续创造美好的事物 🌟',
		];
		const enQuotes = [
			'HELLO, I MAKE THINGS WITH IDEAS & CODE ✨',
			'Welcome to owocc\'s handmade digital nook 🎨',
			'Blending design & code with alive motion 🚀',
			'A creative archive of ideas & curiosity 💡',
			'Keep curious and craft good things 🌟',
		];

		function setupBubble() {
			const bubbleInner = document.getElementById('hero-bubble-text');
			const bubbleContent = document.getElementById('hero-bubble-content');
			if (!bubbleInner || !bubbleContent) return;

			let index = 0;
			function getQuotes() {
				const lang = document.documentElement.getAttribute('data-lang') || 'cn';
				return lang === 'en' ? enQuotes : cnQuotes;
			}

			function rotate() {
				const quotes = getQuotes();
				index = (index + 1) % quotes.length;
				bubbleInner.classList.add('is-changing');
				setTimeout(function() {
					bubbleContent.textContent = quotes[index];
					bubbleInner.classList.remove('is-changing');
				}, 300);
			}

			setInterval(rotate, 5000);
			window.addEventListener('languagechange', function() {
				const quotes = getQuotes();
				index = index % quotes.length;
				bubbleContent.textContent = quotes[index];
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupBubble);
		} else {
			setupBubble();
		}
		document.addEventListener('astro:page-load', setupBubble);
	})();
</script>
