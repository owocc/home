---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="项目" description="查看创意开发、互动体验与视觉叙事项目，以及每个作品背后的过程与反思。">
	<header class="page-hero page-hero--projects">
		<div class="page-hero__inner shell">
			<span class="page-hero__stamp" aria-hidden="true">ARCHIVE / 01</span>
			<p class="eyebrow">PROJECTS / 项目档案</p>
			<h1 class="display">MADE WITH<br /><span class="poster-label">CURIOSITY.</span></h1>
			<p class="page-hero__lede">从模糊的问题、草图和小实验开始，把设计与代码变成可以被体验的作品。</p>
		</div>
	</header>

	<section class="section listing-section" aria-labelledby="project-list-title">
		<div class="shell">
			<div class="listing-section__intro" data-reveal>
				<div>
					<p class="eyebrow">ALL WORK / 全部作品</p>
					<h2 id="project-list-title">按创作顺序整理</h2>
				</div>
				<p>共 {projects.length} 个公开项目。点击卡片阅读完整案例、设计选择与项目反思。</p>
			</div>
			<div class="project-grid">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>
	</section>

	<section class="archive-cta">
		<div class="archive-cta__inner shell" data-reveal>
			<p class="script">more ideas are coming...</p>
			<h2>想看看创作过程？</h2>
			<a class="button button--ink" href="/blog/">去读创作笔记 <span aria-hidden="true">↗</span></a>
		</div>
	</section>
</Layout>
